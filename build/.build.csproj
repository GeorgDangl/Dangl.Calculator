<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace></RootNamespace>
    <IsPackable>False</IsPackable>
    <NoWarn>CS0649;CS0169</NoWarn>
    <FalloutTelemetryVersion>1</FalloutTelemetryVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Fallout.Common" Version="10.4.0" />
    <PackageDownload Include="GitVersion.Tool" Version="[5.12.0]" />
    <PackageReference Include="Dangl.Fallout.WebDocu" Version="8.0.0" />
    <PackageReference Include="Dangl.Fallout.GitHub" Version="8.0.0" />
    <PackageReference Include="ReportGenerator" Version="5.5.11" />
    <PackageReference Include="docfx.console" Version="2.59.4">
      <ExcludeAssets>build</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FalloutMetadata Include="**/*.json" Exclude="bin/**;obj/**" />
  </ItemGroup>

</Project>
